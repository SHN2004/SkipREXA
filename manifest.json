{
  "manifest_version": 2,
  "name": "SkipREXA",
  "version": "3.0",
  "description": "Upload relevant question papers to ChatGPT based on subject selection",

  "browser_specific_settings": {
    "gecko": {
      "id": "dosa@canteen.yummy"
    }
  },

  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "tabs",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://*.supabase.co/*",
    "https://student.rajagiritech.ac.in/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"]
    }
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "SkipREXA"
  }
}
