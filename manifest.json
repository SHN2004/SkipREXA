{
  "manifest_version": 3,
  "name": "SkipREXA",
  "version": "5.0.1",
  "description": "Exam paper assistant for RSET students - Upload question papers to ChatGPT/Claude for smart study prep",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "scripting",
    "downloads",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://raw.githubusercontent.com/*",
    "http://rajagiritech.ac.in/*",
    "http://student.rajagiritech.ac.in/*",
    "http://www.rajagiritech.ac.in/*",
    "https://rajagiritech.ac.in/*",
    "https://student.rajagiritech.ac.in/*",
    "https://www.rajagiritech.ac.in/*"
  ],
  "optional_host_permissions": [
    "http://rajagiritech.ac.in/*",
    "http://student.rajagiritech.ac.in/*",
    "http://www.rajagiritech.ac.in/*",
    "https://rajagiritech.ac.in/*",
    "https://student.rajagiritech.ac.in/*",
    "https://www.rajagiritech.ac.in/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "rsms_speed_mode",
        "enabled": true,
        "path": "rules/rsms-speed-mode.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "src/content.js"
      ]
    },
    {
      "matches": [
        "http://rajagiritech.ac.in/stud/ktu/Student/Leave.asp*",
        "http://www.rajagiritech.ac.in/stud/ktu/Student/Leave.asp*",
        "http://student.rajagiritech.ac.in/stud/ktu/Student/Leave.asp*",
        "https://rajagiritech.ac.in/stud/ktu/Student/Leave.asp*",
        "https://www.rajagiritech.ac.in/stud/ktu/Student/Leave.asp*",
        "https://student.rajagiritech.ac.in/stud/ktu/Student/Leave.asp*"
      ],
      "js": [
        "src/attendance-content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "SkipREXA"
  }
}
