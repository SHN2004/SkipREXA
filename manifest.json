{
  "manifest_version": 3,
  "name": "SkipREXA",
  "version": "5.0.0",
  "description": "Exam paper assistant for RSET students - Upload question papers to ChatGPT/Claude for smart study prep",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://raw.githubusercontent.com/*",
    "https://student.rajagiritech.ac.in/*"
  ],
  "optional_host_permissions": [
    "https://student.rajagiritech.ac.in/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "src/content.js"
      ]
    }
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "SkipREXA"
  }
}
