{
  "manifest_version": 3,
  "name": "SkipREXA",
  "version": "4.0",
  "description": "Exam paper assistant for RSET students - Upload question papers to ChatGPT for smart study prep",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": ["activeTab", "storage", "contextMenus", "scripting", "downloads", "debugger"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://*.supabase.co/*",
    "https://student.rajagiritech.ac.in/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://gemini.google.com/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SkipREXA"
  }
}
